// Tang Nano 20K constraints for top.v
// Keep the SDRAM magic port names unchanged; Gowin maps these to onboard SDRAM.

// 27 MHz system clock
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Onboard LEDs (active-low on Tang Nano 20K)
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// HDMI TMDS differential pairs
IO_LOC "tmds_clk_p" 33;
IO_LOC "tmds_clk_n" 34;
IO_LOC "tmds_d0_p" 35;
IO_LOC "tmds_d0_n" 36;
IO_LOC "tmds_d1_p" 37;
IO_LOC "tmds_d1_n" 38;
IO_LOC "tmds_d2_p" 39;
IO_LOC "tmds_d2_n" 40;

// UART RX from onboard BL616 USB-to-serial bridge
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// ADS1115 I2C pins — tentative GPIO assignment; wire to these exact FPGA pins.
// Use 3.3 V pull-ups on SCL/SDA; do not pull them up to 5 V.
IO_LOC "ads_scl" 41;
IO_PORT "ads_scl" IO_TYPE=LVCMOS33;
IO_LOC "ads_sda" 42;
IO_PORT "ads_sda" IO_TYPE=LVCMOS33;

// External LED bank (retain the user's current assignments)
IO_LOC "ext_led[0]" 71; IO_PORT "ext_led[0]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[1]" 72; IO_PORT "ext_led[1]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[2]" 73; IO_PORT "ext_led[2]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[3]" 74; IO_PORT "ext_led[3]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[4]" 75; IO_PORT "ext_led[4]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[5]" 86; IO_PORT "ext_led[5]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[6]" 25; IO_PORT "ext_led[6]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[7]" 26; IO_PORT "ext_led[7]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[8]" 27; IO_PORT "ext_led[8]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[9]" 28; IO_PORT "ext_led[9]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[10]" 29; IO_PORT "ext_led[10]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[11]" 30; IO_PORT "ext_led[11]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[12]" 31; IO_PORT "ext_led[12]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[13]" 77; IO_PORT "ext_led[13]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[14]" 76; IO_PORT "ext_led[14]" IO_TYPE=LVCMOS33;
IO_LOC "ext_led[15]" 85; IO_PORT "ext_led[15]" IO_TYPE=LVCMOS33;
